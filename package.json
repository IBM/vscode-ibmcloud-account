{
	"name": "ibmcloud-account",
	"displayName": "IBM Cloud Account",
	"description": "The IBM Cloud account extension for Visual Studio Code provides a single IBM Cloud sign-in experience for all other IBM extensions",
	"version": "1.0.7",
	"engines": {
		"vscode": "^1.38.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:ibmcloud-account.createAccount",
		"onCommand:ibmcloud-account.login",
		"onCommand:ibmcloud-account.logout",
		"onCommand:ibmcloud-account.selectAccount",
		"onCommand:ibmcloud-account.ping"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "ibmcloud-account.createAccount",
				"title": "Create a new account",
				"category": "IBM Cloud"
			},
			{
				"command": "ibmcloud-account.login",
				"title": "Log in",
				"category": "IBM Cloud"
			},
			{
				"command": "ibmcloud-account.logout",
				"title": "Log out",
				"category": "IBM Cloud"
			},
			{
				"command": "ibmcloud-account.selectAccount",
				"title": "Select account",
				"category": "IBM Cloud"
			},
			{
				"command": "ibmcloud-account.ping",
				"title": "Ping",
				"category": "IBM Cloud"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "ibmcloud-account.ping",
					"when": "false"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src",
		"pretest": "npm run compile",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/fs-extra": "^9.0.1",
		"@types/glob": "^7.1.1",
		"@types/mocha": "^5.2.7",
		"@types/node": "^26.6.4",
		"@types/vscode": "^1.38.0",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vscode/test-electron": "^3.1.0",
		"eslint": "^10.12.0",
		"glob": "^7.1.5",
		"mocha": "^12.0.3",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.71.1"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/IBM/vscode-ibmcloud-account.git"
	},
	"publisher": "IBM",
	"dependencies": {
		"axios": "^1.20.0",
		"fs-extra": "^9.0.0",
		"home-dir": "^1.0.0"
	},
	"icon": "images/IBM_Cloud_BlueTeal_Pos_RGB.png"
}
