{
	"name": "ibmcloud-account",
	"displayName": "IBM Cloud Account",
	"description": "The IBM Cloud account extension for Visual Studio Code provides a single IBM Cloud sign-in experience for all other IBM extensions",
	"version": "1.0.7",
	"engines": {
		"vscode": "^1.95.0",
		"node": ">=22"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:ibmcloud-account.createAccount",
		"onCommand:ibmcloud-account.login",
		"onCommand:ibmcloud-account.logout",
		"onCommand:ibmcloud-account.selectAccount",
		"onCommand:ibmcloud-account.ping"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "ibmcloud-account.createAccount",
				"title": "Create a new account",
				"category": "IBM Cloud"
			},
			{
				"command": "ibmcloud-account.login",
				"title": "Log in",
				"category": "IBM Cloud"
			},
			{
				"command": "ibmcloud-account.logout",
				"title": "Log out",
				"category": "IBM Cloud"
			},
			{
				"command": "ibmcloud-account.selectAccount",
				"title": "Select account",
				"category": "IBM Cloud"
			},
			{
				"command": "ibmcloud-account.ping",
				"title": "Ping",
				"category": "IBM Cloud"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "ibmcloud-account.ping",
					"when": "false"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src --ext .ts",
		"pretest": "npm run compile",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.95.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"eslint": "^8.57.1",
		"glob": "^11.0.4",
		"mocha": "^11.7.6",
		"typescript": "^5.8.3",
		"@vscode/test-electron": "^3.0.0"
	},
	"overrides": {
		"diff": "^9.0.0",
		"serialize-javascript": "^7.0.0"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/IBM/vscode-ibmcloud-account.git"
	},
	"publisher": "IBM",
	"dependencies": {
		"axios": "^1.18.1",
		"fs-extra": "^11.3.6",
		"home-dir": "^1.0.0"
	},
	"icon": "images/IBM_Cloud_BlueTeal_Pos_RGB.png"
}
