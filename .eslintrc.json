{
    "root": true,
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
    },
    "plugins": [
        "@typescript-eslint"
    ],
    "rules": {
        "no-throw-literal": "warn",
        "no-unused-expressions": "warn",
        "no-redeclare": "warn",
        "curly": "warn",
        "@typescript-eslint/naming-convention": [
            "warn",
            {
                "selector": "class",
                "format": ["PascalCase"]
            }
        ],
        "semi": ["warn", "always"],
        "eqeqeq": "warn"
    }
}
